#!/usr/bin/env bash
# gozar-dev — run gozar from a git checkout, without installing anything.
#
#   ./gozar-dev discover -t https://example.com -n 20
#   ./gozar-dev selfcheck
#   ./gozar-dev doctor
#
# Design rules, each one paid for by a bug:
#   * the package is found by looking for the module it ACTUALLY runs
#     (gozar/cli.py), not a hard-coded file name — v2.1.2 renamed bot.py to
#     cli.py and this launcher kept asking for bot.py, so `./gozar-dev` said
#     "gozar package not found" from inside the repo (reported 2026-11-29);
#   * the module is run as `-m gozar`, not `-m gozar.<something>`, for the same
#     reason: the entry point is a fact about the package, not about a file;
#   * upward search stops at the first directory that holds the package, so a
#     subdirectory of the repo works too;
#   * GOZAR_HOME wins over everything, and there is no second, misspelled
#     variable to also honour (PROXYFINDER_HOME was a leftover);
#   * a usable venv is preferred, but a venv without aiohttp is worse than no
#     venv, so it falls back and says so.
set -euo pipefail

resolve_self() {
  if command -v readlink >/dev/null 2>&1 && readlink -f "$0" >/dev/null 2>&1; then
    readlink -f "$0"
  else
    python3 - "$0" <<'PY'
import os, sys
print(os.path.realpath(sys.argv[1]))
PY
  fi
}

SELF="$(resolve_self)"
SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"

# the module gozar actually exposes; keep this in step with pyproject/scripts
ENTRY="gozar/cli.py"

find_pkg_root() {
  local d
  # 1) explicit override
  if [ -n "${GOZAR_HOME:-}" ]; then
    if [ -f "${GOZAR_HOME%/}/$ENTRY" ]; then
      echo "${GOZAR_HOME%/}"; return 0
    fi
    # warn, then keep searching: a bad GOZAR_HOME should not hide a good
    # checkout that is right here
    echo "gozar-dev: WARNING — GOZAR_HOME=$GOZAR_HOME has no $ENTRY; ignoring it" >&2
  fi
  # 2) upward from the real script location
  d="$1"
  while [ "$d" != "/" ] && [ -n "$d" ]; do
    if [ -f "$d/$ENTRY" ]; then
      echo "$d"; return 0
    fi
    d="$(dirname "$d")"
  done
  # 3) the current directory, in case the script was invoked from elsewhere
  if [ -f "$PWD/$ENTRY" ]; then echo "$PWD"; return 0; fi
  return 1
}

if ! ROOT="$(find_pkg_root "$SELF_DIR")"; then
  cat >&2 <<EOF
gozar-dev: no gozar checkout found.

  looked for : $ENTRY
  started at : $SELF_DIR
  (upwards to /, then \$PWD, then \$GOZAR_HOME)

If you are inside a checkout, the package directory is missing or incomplete —
re-clone it, or point at it explicitly:

  export GOZAR_HOME=/path/to/gozar
  $SELF --version

If you installed with pip instead, you do not need this script:

  gozar --version        # the installed command
  gozar selfcheck        # if it cannot import itself
EOF
  exit 2
fi

cd "$ROOT"

# ── pick an interpreter ─────────────────────────────────────────────────────
# Order: explicit override, the active venv, then the usual per-project places.
pick_venv() {
  local cand
  for cand in \
      "${GOZAR_VENV:-}" \
      "${VIRTUAL_ENV:-}" \
      "$ROOT/.venv" "$ROOT/venv" \
      "$HOME/.venv" "$HOME/venv" \
      "$HOME/.local/share/virtualenvs"/* ; do
    [ -n "$cand" ] || continue
    [ -d "$cand" ] || continue
    if [ -x "$cand/bin/python3" ] || [ -x "$cand/bin/python" ]; then
      echo "$cand"; return 0
    fi
  done
  return 1
}

PY="python3"
if VENV_DIR="$(pick_venv)"; then
  if [ -x "$VENV_DIR/bin/python3" ]; then
    PY="$VENV_DIR/bin/python3"
  else
    PY="$VENV_DIR/bin/python"
  fi
  if "$PY" -c "import aiohttp" >/dev/null 2>&1; then
    echo "gozar-dev: venv $VENV_DIR" >&2
  else
    echo "gozar-dev: WARNING — $VENV_DIR has no aiohttp; using system python3" >&2
    echo "           fix:  $VENV_DIR/bin/pip install -r requirements.txt" >&2
    PY="python3"
  fi
fi

if ! "$PY" -c "import aiohttp" >/dev/null 2>&1; then
  cat >&2 <<'EOF'
gozar-dev: python package 'aiohttp' is missing.

  python3 -m venv .venv && .venv/bin/pip install -r requirements.txt
  pip install --user -r requirements.txt
  bash install.sh --venv
EOF
  exit 2
fi

# high-concurrency async I/O wants a bigger fd table; failure is not fatal
ulimit -n 4096 2>/dev/null || true

# `-m gozar`: the package's own __main__, which imports gozar.cli. Running a
# module path here would put the entry point's name in two places again.
exec "$PY" -m gozar "$@"
