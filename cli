#!/usr/bin/env bash
# Convenience launcher for gozar (development checkout).
# Usage:  ./cli discover -t https://example.com -n 20
#         ./cli run 10
#         ./cli connect
#
# Works even if this script is symlinked/copied to another folder:
#  1) symlinks are resolved to the real file,
#  2) it walks UP from the script dir looking for the gozar package,
#  3) or set GOZAR_HOME=/path/to/gozar-repo to point it anywhere.
set -euo pipefail

# Resolve symlinks (GNU readlink -f, fallback to python os.path.realpath)
resolve_self() {
  if command -v readlink >/dev/null 2>&1 && readlink -f "$0" >/dev/null 2>&1; then
    readlink -f "$0"
  else
    python3 - "$0" <<'PY'
import os, sys
print(os.path.realpath(sys.argv[1]))
PY
  fi
}
SELF="$(resolve_self)"
SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"

find_pkg_root() {
  # Upward search from the real script location
  local d="$1"
  while [ "$d" != "/" ]; do
    if [ -f "$d/gozar/bot.py" ]; then
      echo "$d"
      return 0
    fi
    d="$(dirname "$d")"
  done
  # Explicit env override
  if [ -n "${PROXYFINDER_HOME:-}" ] && [ -f "${GOZAR_HOME%/}/gozar/bot.py" ]; then
    echo "${PROXYFINDER_HOME%/}"
    return 0
  fi
  return 1
}

if ! ROOT="$(find_pkg_root "$SELF_DIR")"; then
  cat >&2 <<EOF
ERROR: gozar package not found.

Put this script inside (or symlink it into) the gozar repo, or point
it at the repo explicitly:

  export GOZAR_HOME=/path/to/gozar
  ./cli $*

EOF
  exit 1
fi

cd "$ROOT"

# ── environment discovery ────────────────────────────────────────────────
# People keep the venv in different places. Order matters: an explicit
# VIRTUAL_ENV / GOZAR_VENV always wins, then the project-local .venv, then
# $HOME/.venv and $HOME/venv. We only activate a venv that actually has
# python in it, and we never fail the launcher because of a broken venv.
pick_venv() {
  local cand
  for cand in \
      "${GOZAR_VENV:-}" \
      "${VIRTUAL_ENV:-}" \
      "$ROOT/.venv" "$ROOT/venv" \
      "$HOME/.venv" "$HOME/venv" \
      "$HOME/.local/share/virtualenvs"/* ; do
    [ -n "$cand" ] || continue
    if [ -x "$cand/bin/python" ] || [ -x "$cand/bin/python3" ]; then
      echo "$cand"; return 0
    fi
  done
  return 1
}

if VENV_DIR="$(pick_venv)"; then
  # shellcheck disable=SC1091
  source "$VENV_DIR/bin/activate"
  # make sure high-concurrency async I/O has the epoll loop
  case "${VENV_DIR}" in
    *virtualenvs*) : ;;
  esac
  # A venv without the deps is worse than no venv: verify, then fall back.
  if ! python3 -c "import aiohttp" >/dev/null 2>&1; then
    echo "gozar: WARNING — $VENV_DIR has no aiohttp; falling back to system python3" >&2
    echo "        fix it with:  $VENV_DIR/bin/pip install -r requirements.txt" >&2
    deactivate 2>/dev/null || true
  else
    echo "gozar: using venv $VENV_DIR" >&2
  fi
else
  echo "gozar: no venv found (looked at VIRTUAL_ENV, GOZAR_VENV, ./.venv, ./venv, ~/.venv, ~/venv)" >&2
fi

# last resort: give a copy-pasteable fix instead of a bare ImportError
if ! python3 -c "import aiohttp" >/dev/null 2>&1; then
  cat >&2 <<'EOF'
gozar: ERROR — python package 'aiohttp' is missing.
        install it with one of:
          python3 -m venv .venv && .venv/bin/pip install -r requirements.txt
          pip install --user -r requirements.txt
          bash install.sh
EOF
  exit 1
fi

# Raise file descriptor limit for high concurrency (best effort)
ulimit -n 4096 2>/dev/null || true

exec python3 -m gozar.bot "$@"
